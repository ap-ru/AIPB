# The widget assistant (Claude). Leave the key empty to run without it.
ANTHROPIC_API_KEY=
# Model per assistant stage: Haiku for the light stages, Sonnet for the reasoning-heavy ones
AIPB_MODEL_INTAKE=claude-haiku-5-5
AIPB_MODEL_BUILD=claude-sonnet-5-5
AIPB_MODEL_REVIEW=claude-sonnet-5-5
AIPB_MODEL_PRESENT=claude-haiku-5-5
# Effort per assistant stage: low | medium | high | xhigh | max (medium was about $0.35-0.45 per widget all on Opus 5.5)
AIPB_EFFORT_INTAKE=medium
AIPB_EFFORT_BUILD=medium
AIPB_EFFORT_REVIEW=medium
AIPB_EFFORT_PRESENT=medium
# Set to true once to wipe and re-seed the app demo book (aipb DB) on backend start.
AIPB_RESET=false
# Set to true once to regenerate the synthetic source data (bank DB).
BANK_RESET=false

# MongoDB accounts (see mongo-init/01-users.js). These defaults are for local development only: Mongo is bound to
# localhost, but change them before running the stack anywhere else. They are applied when the Mongo volume is first
# created; after changing them, remove the volume (docker compose down -v).
MONGO_ROOT_PASSWORD=local-dev-root-change-me
AIPB_APP_PASSWORD=local-dev-app-change-me
BANK_WRITER_PASSWORD=local-dev-bankwriter-change-me
BANK_READER_PASSWORD=local-dev-bankreader-change-me
