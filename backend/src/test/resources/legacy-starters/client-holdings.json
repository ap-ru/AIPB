{
  "id": "client-holdings",
  "version": 2,
  "title": "Product holdings",
  "description": "Every product the selected client holds, with its current amount: drawn balance for credit, balance for deposits, notional for hedges and mandates.",
  "params": [
    {
      "name": "clientId",
      "type": "string",
      "description": "Client key (clients.clientId), e.g. CL-0001"
    }
  ],
  "data": {
    "collection": "holdings",
    "pipeline": [
      {
        "$match": {
          "clientId": {
            "$param": "clientId"
          }
        }
      },
      {
        "$sort": {
          "lob": 1,
          "productName": 1
        }
      },
      {
        "$project": {
          "_id": 0,
          "productName": 1,
          "lob": 1,
          "status": 1,
          "committedUsd": {
            "$ifNull": [
              "$committedUsd",
              null
            ]
          },
          "amountUsd": {
            "$ifNull": [
              "$drawnUsd",
              {
                "$ifNull": [
                  "$balanceUsd",
                  {
                    "$ifNull": [
                      "$notionalUsd",
                      null
                    ]
                  }
                ]
              }
            ]
          },
          "maturityDate": {
            "$ifNull": [
              "$maturityDate",
              null
            ]
          }
        }
      }
    ],
    "columns": [
      {
        "name": "productName",
        "type": "string",
        "label": "Product"
      },
      {
        "name": "lob",
        "type": "string",
        "label": "LOB"
      },
      {
        "name": "status",
        "type": "string",
        "format": "badge",
        "label": "Status",
        "tones": {
          "Active": "good",
          "Maturing": "warn",
          "Pending": "info",
          "Completed": "neutral"
        }
      },
      {
        "name": "amountUsd",
        "type": "number",
        "unit": "USD",
        "format": "currency",
        "label": "Drawn / balance / notional"
      },
      {
        "name": "committedUsd",
        "type": "number",
        "unit": "USD",
        "format": "currency",
        "label": "Committed"
      },
      {
        "name": "maturityDate",
        "type": "date",
        "unit": "date",
        "format": "date",
        "label": "Maturity"
      }
    ]
  },
  "view": {
    "primitive": "table",
    "columns": [
      "productName",
      "lob",
      "status",
      "amountUsd",
      "committedUsd",
      "maturityDate"
    ]
  },
  "layout": {
    "span": 12
  },
  "provenance": {
    "author": "starter",
    "sampleParams": {
      "clientId": "CL-0001"
    }
  }
}
