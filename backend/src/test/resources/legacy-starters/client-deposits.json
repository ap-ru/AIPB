{
  "id": "client-deposits",
  "version": 2,
  "title": "Deposits",
  "description": "Current deposit balances for the selected client, with the number of deposit accounts.",
  "params": [
    {
      "name": "clientId",
      "type": "string",
      "description": "Client key (clients.clientId), e.g. CL-0001"
    }
  ],
  "data": {
    "collection": "holdings",
    "pipeline": [
      {
        "$match": {
          "clientId": {
            "$param": "clientId"
          },
          "productType": "deposit"
        }
      },
      {
        "$group": {
          "_id": null,
          "depositsUsd": {
            "$sum": "$balanceUsd"
          },
          "accounts": {
            "$sum": 1
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "depositsUsd": 1,
          "accounts": 1
        }
      }
    ],
    "columns": [
      {
        "name": "depositsUsd",
        "type": "number",
        "unit": "USD",
        "format": "currency",
        "label": "Deposits"
      },
      {
        "name": "accounts",
        "type": "number",
        "unit": "count",
        "format": "integer",
        "label": "Accounts"
      }
    ]
  },
  "view": {
    "primitive": "metric",
    "value": "depositsUsd",
    "secondary": "accounts",
    "polarity": "higherIsBetter"
  },
  "layout": {
    "span": 3
  },
  "provenance": {
    "author": "starter",
    "sampleParams": {
      "clientId": "CL-0001"
    }
  }
}
