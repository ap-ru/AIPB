{
  "id": "client-open-opportunities",
  "version": 2,
  "title": "Open opportunities",
  "description": "The selected client's open deals, largest expected revenue first (top 15).",
  "params": [
    {
      "name": "clientId",
      "type": "string",
      "description": "Client key (clients.clientId), e.g. CL-0001"
    }
  ],
  "data": {
    "collection": "opportunities",
    "pipeline": [
      {
        "$match": {
          "clientId": {
            "$param": "clientId"
          },
          "stage": {
            "$nin": [
              "Closed Won",
              "Closed Lost"
            ]
          }
        }
      },
      {
        "$sort": {
          "expectedRevenueUsd": -1
        }
      },
      {
        "$limit": 15
      },
      {
        "$project": {
          "_id": 0,
          "name": 1,
          "stage": 1,
          "probability": 1,
          "expectedRevenueUsd": 1,
          "closeDate": 1,
          "owner": 1
        }
      }
    ],
    "columns": [
      {
        "name": "name",
        "type": "string",
        "label": "Opportunity"
      },
      {
        "name": "stage",
        "type": "string",
        "label": "Stage"
      },
      {
        "name": "probability",
        "type": "number",
        "unit": "percent",
        "format": "percentPoints",
        "label": "Probability"
      },
      {
        "name": "expectedRevenueUsd",
        "type": "number",
        "unit": "USD",
        "format": "currency",
        "label": "Expected revenue"
      },
      {
        "name": "closeDate",
        "type": "date",
        "unit": "date",
        "format": "date",
        "label": "Close"
      },
      {
        "name": "owner",
        "type": "string",
        "label": "Owner"
      }
    ]
  },
  "view": {
    "primitive": "table",
    "columns": [
      "name",
      "stage",
      "probability",
      "expectedRevenueUsd",
      "closeDate",
      "owner"
    ]
  },
  "layout": {
    "span": 8
  },
  "provenance": {
    "author": "starter",
    "sampleParams": {
      "clientId": "CL-0001"
    }
  }
}
