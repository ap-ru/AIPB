{
  "id": "client-covenants",
  "version": 2,
  "title": "Covenants",
  "description": "Financial covenants on the selected client's facilities at the last quarterly test, tightest headroom first.",
  "params": [
    {
      "name": "clientId",
      "type": "string",
      "description": "Client key (clients.clientId), e.g. CL-0001"
    }
  ],
  "data": {
    "collection": "covenants",
    "pipeline": [
      {
        "$match": {
          "clientId": {
            "$param": "clientId"
          }
        }
      },
      {
        "$lookup": {
          "from": "holdings",
          "localField": "holdingId",
          "foreignField": "holdingId",
          "as": "facility"
        }
      },
      {
        "$sort": {
          "headroomPct": 1
        }
      },
      {
        "$project": {
          "_id": 0,
          "name": 1,
          "status": 1,
          "headroomPct": 1,
          "facility": {
            "$first": "$facility.productName"
          },
          "actual": {
            "$switch": {
              "branches": [
                {
                  "case": {
                    "$eq": [
                      "$unit",
                      "USD"
                    ]
                  },
                  "then": {
                    "$concat": [
                      {
                        "$literal": "$"
                      },
                      {
                        "$toString": {
                          "$round": [
                            {
                              "$divide": [
                                "$actual",
                                1000000
                              ]
                            },
                            1
                          ]
                        }
                      },
                      "M"
                    ]
                  }
                },
                {
                  "case": {
                    "$eq": [
                      "$unit",
                      "%"
                    ]
                  },
                  "then": {
                    "$concat": [
                      {
                        "$toString": {
                          "$round": [
                            "$actual",
                            1
                          ]
                        }
                      },
                      "%"
                    ]
                  }
                }
              ],
              "default": {
                "$concat": [
                  {
                    "$toString": {
                      "$round": [
                        "$actual",
                        2
                      ]
                    }
                  },
                  "x"
                ]
              }
            }
          },
          "limit": {
            "$concat": [
              "$operator",
              " ",
              {
                "$switch": {
                  "branches": [
                    {
                      "case": {
                        "$eq": [
                          "$unit",
                          "USD"
                        ]
                      },
                      "then": {
                        "$concat": [
                          {
                            "$literal": "$"
                          },
                          {
                            "$toString": {
                              "$round": [
                                {
                                  "$divide": [
                                    "$threshold",
                                    1000000
                                  ]
                                },
                                1
                              ]
                            }
                          },
                          "M"
                        ]
                      }
                    },
                    {
                      "case": {
                        "$eq": [
                          "$unit",
                          "%"
                        ]
                      },
                      "then": {
                        "$concat": [
                          {
                            "$toString": {
                              "$round": [
                                "$threshold",
                                1
                              ]
                            }
                          },
                          "%"
                        ]
                      }
                    }
                  ],
                  "default": {
                    "$concat": [
                      {
                        "$toString": {
                          "$round": [
                            "$threshold",
                            2
                          ]
                        }
                      },
                      "x"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    ],
    "columns": [
      {
        "name": "name",
        "type": "string",
        "label": "Covenant"
      },
      {
        "name": "facility",
        "type": "string",
        "label": "Facility"
      },
      {
        "name": "actual",
        "type": "string",
        "label": "Actual"
      },
      {
        "name": "limit",
        "type": "string",
        "label": "Limit"
      },
      {
        "name": "headroomPct",
        "type": "number",
        "unit": "percent",
        "format": "percentPoints",
        "label": "Headroom"
      },
      {
        "name": "status",
        "type": "string",
        "format": "badge",
        "label": "Status",
        "tones": {
          "Compliant": "good",
          "Watch": "warn",
          "Breach": "bad"
        }
      }
    ]
  },
  "view": {
    "primitive": "table",
    "columns": [
      "name",
      "facility",
      "actual",
      "limit",
      "headroomPct",
      "status"
    ]
  },
  "layout": {
    "span": 7
  },
  "provenance": {
    "author": "starter",
    "sampleParams": {
      "clientId": "CL-0002"
    }
  }
}
