{
  "id": "client-exposure",
  "version": 2,
  "title": "Credit exposure",
  "description": "Drawn balance across the selected client's credit facilities, with utilization of the committed limit.",
  "params": [
    {
      "name": "clientId",
      "type": "string",
      "description": "Client key (clients.clientId), e.g. CL-0001"
    }
  ],
  "data": {
    "collection": "holdings",
    "pipeline": [
      {
        "$match": {
          "clientId": {
            "$param": "clientId"
          },
          "productType": "credit"
        }
      },
      {
        "$group": {
          "_id": null,
          "exposureUsd": {
            "$sum": "$drawnUsd"
          },
          "committedUsd": {
            "$sum": "$committedUsd"
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "exposureUsd": 1,
          "committedUsd": 1,
          "utilization": {
            "$cond": [
              {
                "$gt": [
                  "$committedUsd",
                  0
                ]
              },
              {
                "$divide": [
                  "$exposureUsd",
                  "$committedUsd"
                ]
              },
              0
            ]
          }
        }
      }
    ],
    "columns": [
      {
        "name": "exposureUsd",
        "type": "number",
        "unit": "USD",
        "format": "currency",
        "label": "Exposure"
      },
      {
        "name": "committedUsd",
        "type": "number",
        "unit": "USD",
        "format": "currency",
        "label": "Committed"
      },
      {
        "name": "utilization",
        "type": "number",
        "unit": "ratio",
        "format": "percent",
        "label": "Utilization"
      }
    ]
  },
  "view": {
    "primitive": "meter",
    "value": "exposureUsd",
    "reference": "committedUsd",
    "secondary": "utilization",
    "polarity": "lowerIsBetter",
    "warnAt": 0.8
  },
  "layout": {
    "span": 3
  },
  "provenance": {
    "author": "starter",
    "sampleParams": {
      "clientId": "CL-0001"
    }
  }
}
