[ {
  "purpose" : "Revenue: revenueUsd over last 12 months",
  "collection" : "revenue_monthly",
  "pipeline" : [ {
    "$match" : {
      "clientId" : {
        "$eq" : "CL-0001"
      },
      "month" : {
        "$gte" : {
          "$date" : "2025-10-01T00:00:00Z"
        },
        "$lt" : {
          "$date" : "2026-10-01T00:00:00Z"
        }
      }
    }
  }, {
    "$group" : {
      "_id" : {
        "lob" : "$lob"
      },
      "m0" : {
        "$sum" : "$totalUsd"
      }
    }
  }, {
    "$project" : {
      "_id" : 0,
      "lob" : "$_id.lob",
      "m0" : 1
    }
  } ]
} ]
