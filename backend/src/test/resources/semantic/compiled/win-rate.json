[ {
  "purpose" : "Opportunities: wonDeals, lostDeals",
  "collection" : "opportunities",
  "pipeline" : [ {
    "$group" : {
      "_id" : null,
      "m0" : {
        "$sum" : {
          "$cond" : [ {
            "$eq" : [ "$stage", "Closed Won" ]
          }, 1, 0 ]
        }
      },
      "m1" : {
        "$sum" : {
          "$cond" : [ {
            "$eq" : [ "$stage", "Closed Lost" ]
          }, 1, 0 ]
        }
      }
    }
  }, {
    "$project" : {
      "_id" : 0,
      "m0" : 1,
      "m1" : 1
    }
  } ]
}, {
  "purpose" : "Holdings: productsHeld",
  "collection" : "holdings",
  "pipeline" : [ {
    "$group" : {
      "_id" : null,
      "m0" : {
        "$addToSet" : "$productId"
      }
    }
  }, {
    "$project" : {
      "_id" : 0,
      "m0" : {
        "$size" : {
          "$setDifference" : [ "$m0", [ null ] ]
        }
      }
    }
  } ]
} ]
