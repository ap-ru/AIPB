[ {
  "purpose" : "Revenue: revenueUsd over last 12 months",
  "collection" : "revenue_monthly",
  "pipeline" : [ {
    "$match" : {
      "month" : {
        "$gte" : {
          "$date" : "2025-10-01T00:00:00Z"
        },
        "$lt" : {
          "$date" : "2026-10-01T00:00:00Z"
        }
      }
    }
  }, {
    "$lookup" : {
      "from" : "clients",
      "localField" : "clientId",
      "foreignField" : "clientId",
      "as" : "_j_client"
    }
  }, {
    "$set" : {
      "_j_client" : {
        "$first" : "$_j_client"
      }
    }
  }, {
    "$match" : {
      "_j_client.region" : {
        "$eq" : "EMEA"
      }
    }
  }, {
    "$group" : {
      "_id" : {
        "client" : "$clientId",
        "client__display" : "$_j_client.name"
      },
      "m0" : {
        "$sum" : "$totalUsd"
      }
    }
  }, {
    "$project" : {
      "_id" : 0,
      "client" : "$_id.client",
      "clientName" : "$_id.client__display",
      "m0" : 1
    }
  } ]
} ]
