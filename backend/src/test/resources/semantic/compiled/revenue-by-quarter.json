[ {
  "purpose" : "Revenue: revenueUsd over last 8 closed quarters",
  "collection" : "revenue_monthly",
  "pipeline" : [ {
    "$match" : {
      "clientId" : {
        "$eq" : "CL-0001"
      },
      "month" : {
        "$gte" : {
          "$date" : "2024-10-01T00:00:00Z"
        },
        "$lt" : {
          "$date" : "2026-10-01T00:00:00Z"
        }
      }
    }
  }, {
    "$group" : {
      "_id" : {
        "quarter" : {
          "$dateTrunc" : {
            "date" : "$month",
            "unit" : "quarter"
          }
        }
      },
      "m0" : {
        "$sum" : "$totalUsd"
      }
    }
  }, {
    "$project" : {
      "_id" : 0,
      "quarter" : "$_id.quarter",
      "m0" : 1
    }
  } ]
} ]
