[ {
  "purpose" : "Holdings records over next 90 days (by maturity date)",
  "collection" : "holdings",
  "pipeline" : [ {
    "$match" : {
      "maturityDate" : {
        "$gte" : {
          "$date" : "2026-10-16T00:00:00Z"
        },
        "$lt" : {
          "$date" : "2027-01-14T00:00:00Z"
        }
      }
    }
  }, {
    "$project" : {
      "_id" : 0,
      "productName" : "$productName",
      "amountUsd" : {
        "$ifNull" : [ "$drawnUsd", "$balanceUsd", "$notionalUsd", null ]
      },
      "maturityDate" : "$maturityDate",
      "_key" : "$holdingId"
    }
  }, {
    "$sort" : {
      "maturityDate" : 1,
      "_key" : 1
    }
  }, {
    "$limit" : 51
  }, {
    "$unset" : "_key"
  } ]
} ]
