[ {
  "purpose" : "Covenants records",
  "collection" : "covenants",
  "pipeline" : [ {
    "$match" : {
      "clientId" : {
        "$eq" : "CL-0001"
      }
    }
  }, {
    "$lookup" : {
      "from" : "holdings",
      "localField" : "holdingId",
      "foreignField" : "holdingId",
      "as" : "_j_holding"
    }
  }, {
    "$set" : {
      "_j_holding" : {
        "$first" : "$_j_holding"
      }
    }
  }, {
    "$project" : {
      "_id" : 0,
      "name" : "$name",
      "facility" : "$_j_holding.productName",
      "actual" : "$actual",
      "threshold" : "$threshold",
      "headroomPct" : "$headroomPct",
      "status" : "$status",
      "unit" : "$unit",
      "_key" : "$covenantId"
    }
  }, {
    "$sort" : {
      "headroomPct" : 1,
      "_key" : 1
    }
  }, {
    "$limit" : 51
  }, {
    "$unset" : "_key"
  } ]
} ]
