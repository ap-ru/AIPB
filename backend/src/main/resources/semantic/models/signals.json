{
  "id": "signals",
  "label": "Signals",
  "version": 2,
  "description": "Risk, opportunity, service and market signals detected about clients, with their triage stage, and what each traces to: the holding, covenant or deal it concerns and, through it, the product.",
  "node": "Signal",
  "entity": "clientId",
  "entityJoin": { "rel": "ABOUT", "dir": "out" },
  "time": { "field": "detectedAt", "grain": "month", "closedOnly": false },
  "joins": {
    "holding": { "rel": "CONCERNS", "dir": "out", "node": "Holding" },
    "covenant": { "rel": "CONCERNS", "dir": "out", "node": "Covenant" },
    "deal": { "rel": "CONCERNS", "dir": "out", "node": "Opportunity" },
    "covenantFacility": { "path": [{ "rel": "CONCERNS", "dir": "out", "node": "Covenant" }, { "rel": "HAS_COVENANT", "dir": "in", "node": "Holding" }] },
    "holdingProduct": { "path": [{ "rel": "CONCERNS", "dir": "out", "node": "Holding" }, { "rel": "OF_PRODUCT", "dir": "out", "node": "Product" }] },
    "covenantProduct": { "path": [{ "rel": "CONCERNS", "dir": "out", "node": "Covenant" }, { "rel": "HAS_COVENANT", "dir": "in", "node": "Holding" },
                                  { "rel": "OF_PRODUCT", "dir": "out", "node": "Product" }] },
    "dealProduct": { "path": [{ "rel": "CONCERNS", "dir": "out", "node": "Opportunity" }, { "rel": "FOR_PRODUCT", "dir": "out", "node": "Product" }] }
  },
  "dimensions": {
    "signalCategory": "category",
    "signalType": "type",
    "severity": "severity",
    "signalStage": "stage",
    "signalSource": "source"
  },
  "segments": {
    "active": { "description": "unresolved signals", "where": [{ "field": "stage", "op": "ne", "value": "Resolved" }] },
    "p1": { "description": "P1 signals", "where": [{ "field": "severity", "op": "eq", "value": "P1" }] },
    "risk": { "description": "risk signals", "where": [{ "field": "category", "op": "eq", "value": "Risk" }] },
    "opportunity": { "description": "opportunity signals", "where": [{ "field": "category", "op": "eq", "value": "Opportunity" }] }
  },
  "measures": [
    { "id": "activeSignals", "label": "Active signals", "agg": "count", "segments": ["active"], "unit": "count", "polarity": "lowerIsBetter",
      "description": "Unresolved signals (every stage except Resolved)." },
    { "id": "activeP1Signals", "label": "Active P1 signals", "agg": "count", "segments": ["active", "p1"], "unit": "count", "polarity": "lowerIsBetter",
      "description": "Unresolved signals that need action today." },
    { "id": "riskAtStakeUsd", "label": "Exposure at risk", "agg": "sum", "field": "impactUsd", "segments": ["active", "risk"], "unit": "USD", "polarity": "lowerIsBetter",
      "description": "Estimated exposure at risk across unresolved risk signals." },
    { "id": "opportunityPotentialUsd", "label": "Revenue potential", "agg": "sum", "field": "impactUsd", "segments": ["active", "opportunity"], "unit": "USD", "polarity": "higherIsBetter",
      "description": "Estimated revenue potential across unresolved opportunity signals." },
    { "id": "signalCount", "label": "Signals", "agg": "count", "unit": "count", "polarity": "neutral",
      "description": "Number of signals detected." }
  ],
  "records": {
    "key": "signalId",
    "fields": [
      { "id": "title", "label": "Signal", "field": "title", "type": "string" },
      { "id": "subtitle", "label": "Category · type · stage", "type": "string",
        "expr": "n.category + ' · ' + n.type + ' · ' + n.stage", "sources": ["Signal.category", "Signal.type", "Signal.stage"] },
      { "id": "clientName", "label": "Client", "field": "client.name", "type": "string" },
      { "id": "category", "label": "Category", "field": "category", "type": "string", "dimension": "signalCategory" },
      { "id": "type", "label": "Type", "field": "type", "type": "string" },
      { "id": "severity", "label": "Severity", "field": "severity", "type": "string", "dimension": "severity" },
      { "id": "stage", "label": "Stage", "field": "stage", "type": "string", "dimension": "signalStage" },
      { "id": "detectedAt", "label": "Detected", "field": "detectedAt", "type": "date", "unit": "date" },
      { "id": "impactUsd", "label": "Impact", "field": "impactUsd", "type": "number", "unit": "USD" },
      { "id": "owner", "label": "Owner", "field": "owner", "type": "string" },
      { "id": "summary", "label": "Summary", "field": "summary", "type": "string" },
      { "id": "concerns", "label": "Concerns", "type": "string",
        "expr": "CASE WHEN covenant.name IS NOT NULL THEN 'Covenant: ' + covenant.name + ' on ' + covenantFacility.productName WHEN holding.productName IS NOT NULL THEN 'Holding: ' + holding.productName WHEN deal.name IS NOT NULL THEN 'Deal: ' + deal.name END",
        "sources": ["Covenant.name", "Holding.productName", "Opportunity.name"],
        "description": "What the signal traces to in the graph: the covenant (and its facility), holding or deal it concerns; empty for a signal about the client as a whole." },
      { "id": "trailProduct", "label": "Product", "type": "string",
        "expr": "coalesce(holdingProduct.name, covenantProduct.name, dealProduct.name)", "sources": ["Product.name"],
        "description": "The product the signal traces to, through its holding, its covenant's facility or its deal." },
      { "id": "trailLob", "label": "Line of business", "type": "string",
        "expr": "coalesce(holdingProduct.lob, covenantProduct.lob, dealProduct.lob)", "sources": ["Product.lob"] },
      { "id": "covenantHeadroomPct", "label": "Covenant headroom", "field": "covenant.headroomPct", "type": "number", "unit": "percent" }
    ],
    "defaultSort": [{ "by": "severity", "dir": "asc" }, { "by": "detectedAt", "dir": "desc" }]
  }
}
