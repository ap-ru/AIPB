{
  "id": "client-exposure",
  "version": 2,
  "title": "Credit exposure",
  "description": "Drawn balance across the selected client's credit facilities, with utilization of the committed limit.",
  "params": [
    {
      "name": "clientId",
      "type": "string",
      "description": "Client key (Client.clientId), e.g. CL-0001"
    }
  ],
  "data": {
    "custom": {
      "cypher": "MATCH (:Client {clientId: $clientId})-[:HOLDS]->(h:Holding)\nWHERE h.productType = 'credit'\nWITH sum(h.drawnUsd) AS exposureUsd, sum(h.committedUsd) AS committedUsd\nRETURN exposureUsd, committedUsd, CASE WHEN committedUsd > 0 THEN toFloat(exposureUsd) / committedUsd ELSE 0.0 END AS utilization",
      "columns": [
        {
          "name": "exposureUsd",
          "type": "number",
          "unit": "USD",
          "format": "currency",
          "label": "Exposure"
        },
        {
          "name": "committedUsd",
          "type": "number",
          "unit": "USD",
          "format": "currency",
          "label": "Committed"
        },
        {
          "name": "utilization",
          "type": "number",
          "unit": "ratio",
          "format": "percent",
          "label": "Utilization"
        }
      ]
    }
  },
  "view": {
    "primitive": "meter",
    "value": "exposureUsd",
    "reference": "committedUsd",
    "secondary": "utilization",
    "polarity": "lowerIsBetter",
    "warnAt": 0.8
  },
  "layout": {
    "span": 3
  },
  "provenance": {
    "author": "starter",
    "sampleParams": {
      "clientId": "CL-0001"
    }
  }
}
