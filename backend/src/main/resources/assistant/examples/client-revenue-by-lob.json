{
  "id": "client-revenue-by-lob",
  "version": 2,
  "title": "Revenue by line of business",
  "description": "Trailing-12-month revenue for the selected client, split by line of business.",
  "params": [
    {
      "name": "clientId",
      "type": "string",
      "description": "Client key (Client.clientId), e.g. CL-0001"
    },
    {
      "name": "asOfDate",
      "type": "date",
      "description": "The dataset's 'today' (built in)"
    }
  ],
  "data": {
    "custom": {
      "cypher": "MATCH (r:RevenueMonth)-[:FOR_CLIENT]->(:Client {clientId: $clientId})\nWHERE r.month >= datetime.truncate('month', datetime($asOfDate)) - duration({months: 12})\nRETURN r.lob AS lob, sum(r.totalUsd) AS revenueUsd\nORDER BY revenueUsd DESC",
      "columns": [
        {
          "name": "lob",
          "type": "string",
          "label": "Line of business"
        },
        {
          "name": "revenueUsd",
          "type": "number",
          "unit": "USD",
          "format": "currency",
          "label": "Revenue (T12M)"
        }
      ]
    }
  },
  "view": {
    "primitive": "composition",
    "x": "lob",
    "y": [
      "revenueUsd"
    ]
  },
  "layout": {
    "span": 5
  },
  "provenance": {
    "author": "starter",
    "sampleParams": {
      "clientId": "CL-0001"
    }
  }
}
