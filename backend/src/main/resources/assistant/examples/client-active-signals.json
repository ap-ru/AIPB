{
  "id": "client-active-signals",
  "version": 1,
  "title": "Active signals",
  "description": "The selected client's unresolved signals, most severe and most recent first (top 10).",
  "params": [
    {
      "name": "clientId",
      "type": "string",
      "description": "Client key (Client.clientId), e.g. CL-0001"
    }
  ],
  "data": {
    "custom": {
      "cypher": "MATCH (s:Signal)-[:ABOUT]->(:Client {clientId: $clientId})\nWHERE s.stage <> 'Resolved'\nRETURN s.title AS title, s.category + ' · ' + s.type + ' · ' + s.stage AS subtitle, s.severity AS severity, s.detectedAt AS detectedAt\nORDER BY severity, detectedAt DESC\nLIMIT 10",
      "columns": [
        {
          "name": "title",
          "type": "string",
          "label": "Signal"
        },
        {
          "name": "subtitle",
          "type": "string",
          "label": "Category · type · stage"
        },
        {
          "name": "severity",
          "type": "string",
          "format": "badge",
          "label": "Severity",
          "tones": {
            "P1": "bad",
            "P2": "warn",
            "P3": "info"
          }
        },
        {
          "name": "detectedAt",
          "type": "date",
          "unit": "date",
          "format": "date",
          "label": "Detected"
        }
      ]
    }
  },
  "view": {
    "primitive": "list",
    "title": "title",
    "subtitle": "subtitle",
    "badge": "severity",
    "meta": "detectedAt"
  },
  "layout": {
    "span": 5
  },
  "provenance": {
    "author": "starter",
    "sampleParams": {
      "clientId": "CL-0001"
    }
  }
}
